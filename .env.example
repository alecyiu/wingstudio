# Copy to .env and fill in. .env is not tracked by git, and variables already set
# in the shell take precedence. One KEY=value per line, without trailing comments.

# For the studio's agents and for foam-agent with Claude models.
ANTHROPIC_API_KEY=

# Optional settings.

# Port of the studio server (default 8800).
# STUDIO_PORT=8800

# ParaView's Python, for the viewer pane and the stage images (default below).
# PVPYTHON=/Applications/ParaView-6.2.1.app/Contents/bin/pvpython

# Prompt caching is always on, with a five-minute lifetime. 1h keeps each agent's
# cached instructions for an hour: cheaper when you run several studies with the
# same model in a session, slightly dearer for a single study.
# STUDIO_CACHE_TTL=1h

# Model of foam-agent, any LiteLLM model string (default below). The studio's
# model is chosen in its interface.
# OPENFOAM_AGENT_MODEL=anthropic/claude-sonnet-5-5
